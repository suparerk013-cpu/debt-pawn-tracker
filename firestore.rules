rules_version = '2';
// Two-person household app, no real password (see README) — anyone who is signed in
// (even anonymously) can read/write everything. This matches the app's original security
// model exactly: typing a known username was never a real password gate either.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
